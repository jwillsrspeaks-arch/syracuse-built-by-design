# Copy to .env and fill in real values before running docker-compose.prod.yml

# Passcode required to open /dashboard (and to manage invites). Use a long random string.
DASHBOARD_PASSWORD=

# Google Sheets export (optional — leave blank to disable /api/export/sheets).
# Web-app URL of the Apps Script you deployed from your own spreadsheet
# (Deploy > New deployment > Web app; execute as Me, access Anyone).
GOOGLE_APPS_SCRIPT_URL=

# Shared token; the same value must be pasted into the TOKEN line of the Apps Script.
GOOGLE_APPS_SCRIPT_TOKEN=

# Host port for the web container (default 80). Set e.g. WEB_PORT=8080 if a reverse
# proxy on the same host already owns port 80.
WEB_PORT=80
